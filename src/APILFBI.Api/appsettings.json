{
  "ConnectionStrings": {
    "Bilf": ""
  },
  "Auth": {
    "Emisor": "APILFBI",
    "Audiencia": "APILFBI",
    "LlaveFirma": "",
    "ExpiracionMinutos": 60
  },
  "Cache": {
    "IntervaloRevisionSegundos": 60,
    "TtlRespaldoMinutos": 30
  },
  "Bitacora": {
    "Capacidad": 10000,
    "TamanoLote": 200,
    "IntervaloVaciadoMs": 2000
  },
  "RateLimit": {
    "PermisosPorMinuto": 600,
    "TokenPorMinuto": 10
  },
  "Proxy": {
    "ProxiesConocidos": []
  },
  "Laserfiche": {
    "Simulado": true,
    "UrlBase": "https://laserfiche-regqa.corporacionbi.com/LFRepositoryAPI/",
    "RepositorioId": "",
    "Usuario": "",
    "Contrasena": "",
    "TimeoutSegundos": 60,
    "Reintentos": 3,
    "RenovarTokenAntesSegundos": 120,
    "Rutas": {
      "Token": "v1/Repositories/{repositorio}/Token",
      "Descarga": "v1/Repositories/{repositorio}/Entries/{entryId}/Laserfiche.Repository.Document/edoc",
      "Campos": "v1/Repositories/{repositorio}/Entries/{entryId}/fields",
      "Salud": "v1/Repositories"
    },
    "Campos": {
      "Estado": "Estado",
      "EjecutivoAsignado": "EjecutivoAsignado",
      "TipoRechazo": "TipoRechazo",
      "ComentarioRevision": "ComentarioRevision",
      "EtapaRechazo": "EtapaRechazo"
    },
    "Simulacion": {
      "CarpetaArchivos": ""
    }
  },
  "CargaApi": {
    "CarpetaImportAgent": "\\\\servidor-laserfiche\\ImportAgent\\CRM",
    "TamanoMaximoSolicitudMB": 50,
    "AlertaRecibidasMinutos": 60
  },
  "DataProtection": {
    "CertificadoThumbprint": ""
  },
  "OpenApi": {
    "Habilitado": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AllowedHosts": "*"
}
