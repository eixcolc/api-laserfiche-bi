{
  "ConnectionStrings": {
    "Bilf": ""
  },
  "Worker": {
    "ZonaHoraria": "Central America Standard Time",
    "HoraVencimiento": "01:00",
    "HoraLimpieza": "02:00",
    "IntervaloSincronizacionSegundos": 30,
    "EjecutarVencimientoAlIniciar": false
  },
  "SincronizacionLaserfiche": {
    "Lote": 50,
    "MaxIntentos": 10,
    "EsperaBaseSegundos": 30,
    "EsperaMaximaMinutos": 60,
    "ReservaSegundos": 300
  },
  "Laserfiche": {
    "Simulado": true,
    "UrlBase": "https://servidor-laserfiche/LFRepositoryAPI/",
    "RepositorioId": "",
    "Usuario": "",
    "Contrasena": "",
    "TimeoutSegundos": 60,
    "Reintentos": 3,
    "RenovarTokenAntesSegundos": 120,
    "Rutas": {
      "Token": "v1/Repositories/{repositorio}/Token",
      "Descarga": "v1/Repositories/{repositorio}/Entries/{entryId}/Laserfiche.Repository.Document/edoc",
      "Campos": "v1/Repositories/{repositorio}/Entries/{entryId}/fields",
      "Salud": "v1/Repositories"
    },
    "Campos": {
      "Estado": "Estado",
      "EjecutivoAsignado": "EjecutivoAsignado",
      "TipoRechazo": "TipoRechazo",
      "ComentarioRevision": "ComentarioRevision",
      "EtapaRechazo": "EtapaRechazo"
    }
  },
  "Cache": {
    "IntervaloRevisionSegundos": 60,
    "TtlRespaldoMinutos": 30
  },
  "Bitacora": {
    "Capacidad": 10000,
    "TamanoLote": 200,
    "IntervaloVaciadoMs": 2000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  }
}
